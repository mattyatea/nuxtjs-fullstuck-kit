generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../server/prisma-client"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../server/prisma-client/zod"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
